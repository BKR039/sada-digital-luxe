# ==============================================================================
# SADA OS — STAGING ENVIRONMENT TEMPLATE (.env.staging.example)
# ==============================================================================
# MANDATORY SAFETY NOTICE:
# 1. This file is a TEMPLATE with placeholders only.
# 2. To use, copy this file to `.env.staging` (which is gitignored).
# 3. NEVER put production credentials or the production project ref here.
# 4. Canonical Production Project Ref is: mtfkzabiscyleztypqks
#    ANY configuration pointing to mtfkzabiscyleztypqks will be unconditionally
#    BLOCKED by scripts/test-db-guard.ts to protect production data.
# 5. NEVER commit `.env.staging` or real API keys to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Isolated Staging Supabase Project Identity
# Replace with your dedicated staging Supabase project reference and URL.
# MUST BE DISTINCT from mtfkzabiscyleztypqks!
# ------------------------------------------------------------------------------
SUPABASE_PROJECT_ID="your-isolated-staging-ref"
SUPABASE_URL="https://your-isolated-staging-ref.supabase.co"

# ------------------------------------------------------------------------------
# 2. Client-Side Public Keys (Vite)
# ------------------------------------------------------------------------------
VITE_SUPABASE_PROJECT_ID="your-isolated-staging-ref"
VITE_SUPABASE_URL="https://your-isolated-staging-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-staging-anon-token-placeholder"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-staging-anon-token-placeholder"

# ------------------------------------------------------------------------------
# 3. Server-Side / Node Environment Fallbacks
# ------------------------------------------------------------------------------
SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-staging-anon-token-placeholder"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-staging-anon-token-placeholder"

# ------------------------------------------------------------------------------
# 4. Staging Administrative & Migration Key (Confidential)
# Used exclusively for staging migration runs and synthetic test cleanup.
# NEVER expose this key in client bundles or public repositories.
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-staging-service-role-token-placeholder"

# ------------------------------------------------------------------------------
# 5. Database Safety Guard & Test Isolation Flags
# IMPORTANT: TEST_DB_ISOLATED=true is evaluated by scripts/test-db-guard.ts.
# It is REJECTED if the target project matches mtfkzabiscyleztypqks.
# ------------------------------------------------------------------------------
TEST_DB_ISOLATED="true"
SADA_ENVIRONMENT="staging"
