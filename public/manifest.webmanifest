{
  "name": "SADA OS — Travel & Creative Operating System",
  "short_name": "SADA OS",
  "description": "High-performance operational operating system for creative agencies, multi-stage content production, and team execution.",
  "id": "sada-os-app",
  "start_url": "/sada-os",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "window-controls-overlay",
    "minimal-ui",
    "browser"
  ],
  "background_color": "#222830",
  "theme_color": "#222830",
  "orientation": "portrait-primary",
  "dir": "auto",
  "lang": "en",
  "prefer_related_applications": false,
  "categories": [
    "business",
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "/icons/icon-192x192.png?v=4",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512x512.png?v=4",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512x512.png?v=4",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "My Work Queue",
      "short_name": "My Work",
      "description": "Jump straight to your active assigned tasks and deliverables",
      "url": "/admin/my-work",
      "icons": [
        {
          "src": "/icons/icon-192x192.png?v=4",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Production Calendar",
      "short_name": "Calendar",
      "description": "View scheduled client deliverables and shoots",
      "url": "/admin/calendar",
      "icons": [
        {
          "src": "/icons/icon-192x192.png?v=4",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Executive Overview",
      "short_name": "Overview",
      "description": "Operations dashboard and next prioritized tasks",
      "url": "/admin",
      "icons": [
        {
          "src": "/icons/icon-192x192.png?v=4",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
